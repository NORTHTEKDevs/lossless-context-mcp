{
  "name": "lossless-context-mcp",
  "version": "1.3.0",
  "description": "The flight recorder for your agent context: a persistent ledger of every file version the model was shown - working-set restore after compaction, cache-ready context packs for subagent fan-outs, and git-bound signed receipts.",
  "type": "module",
  "bin": {
    "lossless-context-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "hooks",
    "README.md",
    "BENCHMARK.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "bench": "tsx bench/run.ts",
    "smoke": "node bench/smoke.mjs",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "author": "Kristian Baer / Northtek",
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "tokens",
    "context",
    "agent",
    "lossless",
    "diff",
    "cost"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NORTHTEKDevs/lossless-context-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/NORTHTEKDevs/lossless-context-mcp/issues"
  },
  "homepage": "https://github.com/NORTHTEKDevs/lossless-context-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "diff": "^8.0.2",
    "gpt-tokenizer": "^2.8.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "mcpName": "io.github.NORTHTEKDevs/lossless-context-mcp"
}
